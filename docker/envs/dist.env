APP_DIR=../
# Ruta absoluta de host al proyecto. Solo la usa el contenedor "phpactor": su
# extension de VSCode no soporta mapeo de rutas, asi que el contenedor debe ver
# el proyecto en la misma ruta absoluta que el host.
APP_DIR_ABS=
APP_PORT=80

GIT_AUTHOR_NAME=name
GIT_COMMITTER_NAME=name
GIT_AUTHOR_EMAIL=email
GIT_COMMITTER_EMAIL=email

DB_USER=dev
DB_PASS=dev
DB_NAME=dev

PGADMIN_DEFAULT_EMAIL="email@gmail.com"
PGADMIN_DEFAULT_PASSWORD="password"
CONTAINER_LISTEN_PORT=5433
