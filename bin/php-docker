#!/usr/bin/env bash
# Redirige invocaciones de "php" (hechas por extensiones de VSCode en el host)
# hacia el PHP del contenedor, para no tener que reabrir el proyecto
# con "Dev Containers: Reopen in Container".
set -euo pipefail

DOCKER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../docker" && pwd)"
cd "$DOCKER_DIR"

#docker compose up -d php >/dev/null

exec docker compose exec -T -e XDEBUG_MODE=off php php "$@"
