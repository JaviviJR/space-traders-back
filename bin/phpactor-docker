#!/usr/bin/env bash
# Redirige las invocaciones del language server de Phpactor hechas por la
# extension de VSCode (phpactor.phpactor) hacia el contenedor php via stdio.
# XDEBUG_MODE=off evita cargar el depurador en cada peticion LSP.
set -euo pipefail

DOCKER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../docker" && pwd)"
cd "$DOCKER_DIR"

exec docker compose exec -T -e XDEBUG_MODE=off php php "$@"
