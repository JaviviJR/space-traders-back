#!/usr/bin/env bash
# Redirige las invocaciones de PHP-CS-Fixer hechas por la extension de VSCode
# (higoka.php-cs-fixer) hacia el contenedor php.
# XDEBUG_MODE=off evita que cada analisis intente conectar con el depurador.
set -euo pipefail

DOCKER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../docker" && pwd)"
cd "$DOCKER_DIR"

exec docker compose exec -T -e XDEBUG_MODE=off php vendor/bin/php-cs-fixer "$@"
