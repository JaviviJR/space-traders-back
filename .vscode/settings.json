{
  // Config local para trabajar SIN abrir el proyecto dentro de un devcontainer.
  // Linter PHP built-in desactivado: Intelephense no necesita binario PHP real,
  // y así evitamos depender de una ruta de host hacia el contenedor.
  "php.validate.enable": false,
  // Symfony for VSCode ejecuta sus comandos de consola dentro del contenedor
  // via "docker exec", sin depender de ninguna ruta de host.
  "symfony-vscode.shellExecutable": "/bin/bash",
  "symfony-vscode.shellCommand": "docker exec space-trader-backend-php php \"$@\"",
  "intelephense.environment.phpVersion": "8.4.0",
  "search.exclude": {
    "**/vendor": true,
    "**/var": true
  },
  "php.suggest.basic": false,
  // PHPStan (SanderRonde.phpstan-vscode) ejecutado en el contenedor php via bin/phpstan-docker.
  "phpstan.binCommand": ["${workspaceFolder}/bin/phpstan-docker"],
  "phpstan.paths": { "${workspaceFolder}": "/home/developer/app" },
  "phpstan.configFile": "phpstan.dist.neon",
  "phpstan.showTypeOnHover": true,
  "phpstan.dockerContainerName": "space-trader-backend-php",
  "phpstan.singleFileMode": true,
  "phpstan.tmpDir": "${workspaceFolder}/var/phpstan-vscode"
}
