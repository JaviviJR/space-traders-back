{
  "name": "space-trader-backend",
  "dockerComposeFile": "../docker/compose.yml",
  "service": "php",
  "workspaceFolder": "/home/developer/app",
  "shutdownAction": "none",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=claude-code-config,target=/home/developer/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/developer/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "naumovs.color-highlight",
        "ecmel.vscode-html-css",
        "redhat.vscode-yaml",
        "SanderRonde.phpstan-vscode",
        "xdebug.php-debug",
        "phpactor.vscode-phpactor",
        "junstyle.php-cs-fixer",
        "vix.rector-vscode",
        "EditorConfig.EditorConfig",
        "MehediDracula.php-namespace-resolver",
        "symfony.language-tools",
        "jaguadoromero.vscode-php-create-class",
        "emallin.phpunit",
        "mblode.twig-language-2",
        "phproberto.vscode-php-getters-setters",
        "mikestead.dotenv",
        "waderyan.gitblame",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "GitHub.vscode-pull-request-github",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "symfony-vscode.phpExecutablePath": "/usr/local/bin/php-no-xdebug",
        "symfony-vscode.shellExecutable": "/bin/bash",
        "phpstan.configFile": "phpstan.dist.neon",
        "phpstan.showTypeOnHover": true,
        "search.exclude": {
            "**/vendor": true,
            "**/var": true
        },
        "php.suggest.basic": false,
        "phpstan.singleFileMode": true,
        "php-cs-fixer.autoFixByBracket": true,
        "php-cs-fixer.autoFixBySemicolon": true,
        "php-cs-fixer.onsave": true,
        "php-cs-fixer.allowRisky": false,
        "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
        "php-cs-fixer.config": "${workspaceFolder}/.php-cs-fixer.dist.php",
        "[php]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "junstyle.php-cs-fixer"
        }
      }
    }
  }
}
