{
    "$schema": "/opt/phpactor/phpactor.schema.json",
    "language_server.self_destruct_timeout": 30000,
    "language_server.shutdown_grace_period": 1000,
    "language_server_phpstan.enabled": true,
    "symfony.enabled": true,
    "indexer.exclude_patterns": [
        "/vendor/**/Tests/**/*",
        "/vendor/**/tests/**/*",
        "/var/cache/**/*",
        "/vendor/composer/**/*"
    ]
}
