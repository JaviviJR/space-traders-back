#!/usr/bin/env bash
# Redirige las invocaciones de PHPStan hechas por la extension de VSCode
# (SanderRonde.phpstan-vscode) hacia el contenedor php.
# XDEBUG_MODE=off evita que cada analisis intente conectar con el depurador.
set -euo pipefail

DOCKER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../docker" && pwd)"
cd "$DOCKER_DIR"

exec docker compose exec -T -e XDEBUG_MODE=off php vendor/bin/phpstan "$@"
